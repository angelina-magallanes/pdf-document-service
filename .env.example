# Configuración para Docker Compose. No subir .env ni credenciales reales.
PORT=8000
# Obligatorio. Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Compartir el valor con la API consumidora por un canal privado. No subirlo a Git.
DOCUMENTS_API_TOKEN=
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=pdf_extractext
# Para el despliegue compartido de integración, usar:
# MONGODB_DATABASE=pdf_extractext_integration
# Confirmar allí la URI; no apuntar pruebas destructivas a datos compartidos.
# Presupuesto por operación, menor que los 2 s de readiness del orquestador.
MONGODB_TIMEOUT_MS=1500
MONGODB_POOL_SIZE=16
MONGODB_WAIT_QUEUE_MS=200
DOCUMENTS_MAX_IN_FLIGHT=16
LOG_LEVEL=INFO
TRAEFIK_DOCUMENTS_HOST=documents.universidad.localhost
TRAEFIK_ENTRYPOINT=web
# Solo se usan con docker-compose.dev.yml.
DOCUMENTS_HOST_PORT=8001
MONGODB_HOST_PORT=27017
