# Configuración para Docker Compose. No subir .env ni credenciales reales.
PORT=8000
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=pdf_extractext
# Presupuesto por operación, menor que los 2 s de readiness del orquestador.
MONGODB_TIMEOUT_MS=1500
LOG_LEVEL=INFO
TRAEFIK_DOCUMENTS_HOST=documents.universidad.localhost
TRAEFIK_ENTRYPOINT=web
# Solo se usan con docker-compose.dev.yml.
DOCUMENTS_HOST_PORT=8001
MONGODB_HOST_PORT=27017
